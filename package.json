{
  "name": "canvas-real-estate",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "studio"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "dev:studio": "npm run dev -w @canvas/studio",
