{
  "name": "@canvas/studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "sanity dev --host 0.0.0.0 --port 3333",
    "start": "sanity start --host 0.0.0.0 --port 3333",
    "build": "sanity schema extract --force && sanity build ../web/dist/studio --yes && node scripts/fix-studio-basepath.mjs",
    "deploy": "sanity deploy",
    "deploy:schema": "sanity schemas deploy",
    "seed": "sanity exec scripts/seed.mjs --with-user-token",
    "seed:dry-run": "sanity exec scripts/seed.mjs -- --dry-run",
    "typegen": "sanity schema extract --force && sanity typegen generate",
    "cors:web": "sanity cors add http://localhost:5173"
  },
  "dependencies": {
    "@sanity/icons": "^5.2.1",
    "@sanity/vision": "^5.31.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanity": "^5.14.1",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.7.0"
  }
}
