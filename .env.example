# Copy to .env.local for local development. Set the same values in Vercel → Settings → Environment Variables.
# None of these use the NEXT_PUBLIC_ prefix except the site URL, so secrets never reach the browser.

# Agentbox listings (FeedSync)
FEEDSYNC_URL=https://canvasrealestate.com.au/XML/feedsync/
FEEDSYNC_ACCESS_KEY=
SYNC_SECRET=                # long random string, used in the sync link
SANITY_WRITE_TOKEN=         # Sanity token with Editor rights (sync writes listings)

# Instant updates when content is published in Sanity (webhook → /api/revalidate)
SANITY_REVALIDATE_SECRET=

# Enquiry forms (https://resend.com)
RESEND_API_KEY=
ENQUIRY_FROM="Canvas Real Estate <website@canvasrealestate.com.au>"
ENQUIRY_TO=enquiry@canvasrealestate.com.au

# Optional
NEXT_PUBLIC_SITE_URL=https://canvasrealestate.com.au
